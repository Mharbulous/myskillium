{
  "plugins": {
    "brahm-shared-tools": {
      "source": {
        "source": "github",
        "repo": "Mharbulous/claude-shared-tools"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-regression-suite.py"
            ],
            "timeout": 10,
            "statusMessage": "No regression suite guard"
          }
        ]
      }
    ]
  }
}
